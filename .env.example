# Pooled Postgres connection string, used by the app at runtime. From your Neon project's "Connect" panel — pick the "Pooled connection" tab. (https://neon.tech)
DATABASE_URL="postgresql://user:password@ep-example-pooler.region.aws.neon.tech/dbname?sslmode=require&channel_binding=require"

# Direct (non-pooled) Postgres connection string, used only for migrations. Same Neon "Connect" panel — pick the "Direct connection" tab.
DIRECT_URL="postgresql://user:password@ep-example.region.aws.neon.tech/dbname?sslmode=require"

# Random secret NextAuth uses to sign session JWTs. Generate your own with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-32-byte-base64-string"

# Base URL NextAuth uses to build callback/redirect links. Use http://localhost:3000 locally; your deployed URL in production.
NEXTAUTH_URL="http://localhost:3000"

# Cloudinary cloud name, used to build the direct-upload URL. From your Cloudinary dashboard's "Product Environment" card. (https://cloudinary.com/console)
CLOUDINARY_CLOUD_NAME="your-cloud-name"

# Cloudinary API key, used server-side to sign uploads. Same Cloudinary dashboard card as above.
CLOUDINARY_API_KEY="000000000000000"

# Cloudinary API secret, used server-side to sign uploads. Never exposed to the client. Same Cloudinary dashboard card as above.
CLOUDINARY_API_SECRET="your-api-secret"

# SMTP server host the outbox drain worker sends mail through. A free Mailtrap "Sandbox" inbox works for local dev. (https://mailtrap.io)
SMTP_HOST="sandbox.smtp.mailtrap.io"

# SMTP server port. Mailtrap sandbox accepts 25, 465, 587, or 2525 — 2525 avoids most local firewall issues.
SMTP_PORT="2525"

# SMTP username. From your Mailtrap inbox's "SMTP Settings" tab (or your real provider's credentials in production).
SMTP_USER="your-smtp-username"

# SMTP password. Same place as SMTP_USER.
SMTP_PASS="your-smtp-password"

# "From" address on outgoing emails (status changes, notices). Any address works with Mailtrap sandbox; use a verified sender in production.
EMAIL_FROM="noreply@example.com"
